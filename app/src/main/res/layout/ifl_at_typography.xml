<instafel.app.ui.Page
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <instafel.app.ui.PageTitle
        android:id="@+id/ifl_page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ifl_attr_ui_titleText="@string/ifl_typography_title" />

    <instafel.app.ui.PageContentArea
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ifl_page_title">

        <!-- FONT SECTION -->
        <instafel.app.ui.TileLargeSwitch
            android:id="@+id/ifl_switch_custom_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ifl_attr_ui_iconRes="@drawable/ifl_misc"
            app:ifl_attr_ui_spaceBottom="visible"
            app:ifl_attr_ui_titleText="@string/ifl_custom_font_switch_title"
            app:ifl_attr_ui_subtitleText="@string/ifl_custom_font_switch_subtitle" />

        <instafel.app.ui.TileLarge
            android:id="@+id/ifl_tile_select_font"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ifl_attr_ui_iconRes="@drawable/ifl_language"
            app:ifl_attr_ui_spaceBottom="visible"
            app:ifl_attr_ui_titleText="@string/ifl_font_family_picker_title"
            app:ifl_attr_ui_subtitleText="@string/ifl_font_sf_pro" />

        <!-- TYPOGRAPHY PREVIEW -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?ifl_attr_tile_color">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/ifl_preview_header_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ifl_typography_preview_header"
                    android:textColor="?ifl_attr_subtitle_color"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/ifl_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ifl_typography_preview_title"
                    android:textColor="?ifl_attr_title_color"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/ifl_preview_subhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ifl_typography_preview_subhead"
                    android:textColor="?ifl_attr_subtitle_color"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/ifl_preview_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ifl_typography_preview_body"
                    android:textColor="?ifl_attr_title_color"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/ifl_preview_italic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ifl_typography_preview_italic"
                    android:textColor="?ifl_attr_subtitle_color"
                    android:textSize="13sp"
                    android:textStyle="italic" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- EMOJI SECTION -->
        <instafel.app.ui.TileLargeSwitch
            android:id="@+id/ifl_switch_custom_emoji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ifl_attr_ui_iconRes="@drawable/ifl_android"
            app:ifl_attr_ui_spaceBottom="visible"
            app:ifl_attr_ui_titleText="@string/ifl_custom_emoji_switch_title"
            app:ifl_attr_ui_subtitleText="@string/ifl_custom_emoji_switch_subtitle" />

        <instafel.app.ui.TileLarge
            android:id="@+id/ifl_tile_select_emoji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ifl_attr_ui_iconRes="@drawable/ifl_about"
            app:ifl_attr_ui_spaceBottom="visible"
            app:ifl_attr_ui_titleText="@string/ifl_emoji_picker_title"
            app:ifl_attr_ui_subtitleText="@string/ifl_emoji_ios" />

        <!-- EMOJI PREVIEW -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?ifl_attr_tile_color">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ifl_emoji_preview_title"
                    android:textColor="?ifl_attr_subtitle_color"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/ifl_preview_emojis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="😀  🔥  🚀  ✨  ❤️  🥳  🎉  💫"
                    android:textColor="?ifl_attr_title_color"
                    android:textSize="28sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </instafel.app.ui.PageContentArea>

</instafel.app.ui.Page>
